{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "OpenCLion",
  "version": "0.1.33",
  "identifier": "ai.openclion.ide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenCLion",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#E9EAEE",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 OpenCLion contributors.",
    "license": "Apache-2.0",
    "shortDescription": "An open-source C/C++ IDE in the CLion tradition",
    "longDescription": "OpenCLion is an open-source C/C++ IDE: CMake projects, clangd code insight, LLDB debugging. UI in the IntelliJ CLion tradition. Not affiliated with JetBrains.",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "postInstallScript": "linux/postinst.sh",
        "depends": [
          "libgtk-4-1",
          "libglib2.0-0 | libglib2.0-0t64",
          "libnss3",
          "libnspr4",
          "libgbm1",
          "libdrm2",
          "libxkbcommon0",
          "libxcomposite1",
          "libxdamage1",
          "libxrandr2",
          "libx11-6",
          "libxcb1",
          "libexpat1",
          "libdbus-1-3",
          "libatk-bridge2.0-0 | libatk-bridge2.0-0t64",
          "libatspi2.0-0 | libatspi2.0-0t64",
          "libpango-1.0-0",
          "libcairo2",
          "libasound2 | libasound2t64",
          "libcups2 | libcups2t64"
        ]
      }
    }
  },
  "mainBinaryName": "openclion",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCOUU0MUFFOUY4NzZCNkQKUldSdGE0ZWZya0dlRzNnRFJUR2loUVdNZ1BmamxkNzFoaWNPUTBsRmI0cjhxZFRqQURybkMwakEK",
      "endpoints": []
    }
  }
}
